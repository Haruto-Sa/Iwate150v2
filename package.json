    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.169.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "2.11.34",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
