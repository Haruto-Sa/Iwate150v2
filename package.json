    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@serwist/next": "9.6.0",
    "@supabase/supabase-js": "^2.87.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
